<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Custom Permission Messages for Driver App -->
	<key>NSCameraUsageDescription</key>
	<string>Lizto Conductor requiere acceso a tu cámara para tomar tu foto de perfil, verificar tu identidad vehicular y capturar fotos de documentos o incidencias.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Lizto Conductor necesita acceso a tu galería para subir tu foto de perfil, documentos del vehículo y comprobantes.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Lizto Conductor solicita permiso para guardar recibos y comprobantes de viajes en tu galería si decides descargarlos.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>Lizto Conductor requiere acceso al micrófono para comunicación de audio y mensajes de voz con los pasajeros durante el servicio.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Lizto Conductor utiliza tu ubicación en segundo plano para recibir solicitudes de viajes cercanos, navegar rutas y calcular distancias y tarifas con precisión, incluso cuando la app está minimizada.</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lizto Conductor utiliza tu ubicación para mostrar viajes cercanos, guiar la navegación al punto de recogida y destino, y calcular la tarifa del viaje.</string>

	<key>NSLocationAlwaysUsageDescription</key>
	<string>Lizto Conductor utiliza tu ubicación continua para garantizar el seguimiento del viaje y tu seguridad durante todo el trayecto.</string>
	
	<!-- For Background locations and tasks -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.pravera.flutter_foreground_task.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>

	<!-- Other keys -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Change App Name and bundle name here -->
	<key>CFBundleDisplayName</key>
	<string>Lizto Conductor</string>
	<key>CFBundleName</key>
	<string>liztogopro</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	<key>NSAllowsArbitraryLoads</key><true/>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.714316853778-5og291i5so7bn16t5afda3aijr6qeg0m</string>
			</array>
		</dict>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
